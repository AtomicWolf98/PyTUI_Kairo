{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairo.local/schema/events-v1.json",
  "title": "Kairo KernelEvent envelope v1",
  "type": "object",
  "required": ["$type", "event_id", "kernel_id", "sequence", "timestamp", "event_type", "payload", "schema_version", "turn_sequence", "turn_id", "session_id", "workspace_revision"],
  "additionalProperties": false,
  "properties": {
    "$type": {"const": "kairo_kernel.contracts.events.KernelEvent"},
    "event_id": {"type": "string", "minLength": 1},
    "kernel_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"$ref": "#/$defs/timestamp"},
    "event_type": {"enum": ["lifecycle", "turn", "message", "tool", "interaction", "usage", "context", "session_changed", "config_changed", "workspace_changed", "skills_changed", "provider_changed", "memory_changed", "notice"]},
    "payload": {"$ref": "#/$defs/payload"},
    "schema_version": {"const": 1},
    "turn_sequence": {"type": ["integer", "null"], "minimum": 1},
    "turn_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "workspace_revision": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "lifecycle"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/lifecycle"}}}},
    {"if": {"properties": {"event_type": {"const": "turn"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/turn"}}}},
    {"if": {"properties": {"event_type": {"const": "message"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/message"}}}},
    {"if": {"properties": {"event_type": {"const": "tool"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/tool"}}}},
    {"if": {"properties": {"event_type": {"const": "interaction"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/interaction"}}}},
    {"if": {"properties": {"event_type": {"const": "usage"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/usage"}}}},
    {"if": {"properties": {"event_type": {"enum": ["context", "session_changed", "config_changed", "workspace_changed", "skills_changed", "provider_changed", "memory_changed"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/change"}}}},
    {"if": {"properties": {"event_type": {"const": "notice"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/notice"}}}}
  ],
  "$defs": {
    "timestamp": {"type": "object", "required": ["$datetime"], "additionalProperties": false, "properties": {"$datetime": {"type": "string", "format": "date-time"}}},
    "nullableContract": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["$type"], "properties": {"$type": {"type": "string"}}}]},
    "tuple": {"type": "object", "required": ["$tuple"], "additionalProperties": false, "properties": {"$tuple": {"type": "array"}}},
    "jsonObject": {"type": "object", "required": ["$json_object"], "additionalProperties": false, "properties": {"$json_object": {"type": "array"}}},
    "payload": {"oneOf": [{"$ref": "#/$defs/lifecycle"}, {"$ref": "#/$defs/turn"}, {"$ref": "#/$defs/message"}, {"$ref": "#/$defs/tool"}, {"$ref": "#/$defs/interaction"}, {"$ref": "#/$defs/usage"}, {"$ref": "#/$defs/change"}, {"$ref": "#/$defs/notice"}]},
    "lifecycle": {"type": "object", "required": ["$type", "state", "reason"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.LifecycleEvent"}, "state": {"enum": ["created", "starting", "running", "stopping", "stopped", "degraded"]}, "reason": {"type": "string"}}},
    "turn": {"type": "object", "required": ["$type", "status", "phase", "reason"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.TurnEvent"}, "status": {"enum": ["accepted", "running", "waiting_input", "stopping", "succeeded", "cancelled", "failed"]}, "phase": {"enum": [null, "planning", "connecting", "thinking", "streaming", "waiting_approval", "running_tool", "compacting"]}, "reason": {"type": "string"}}},
    "message": {"type": "object", "required": ["$type", "message_id", "action", "content"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.MessageEvent"}, "message_id": {"type": "string"}, "action": {"type": "string"}, "content": {"$ref": "#/$defs/tuple"}}},
    "tool": {"type": "object", "required": ["$type", "action", "invocation", "output", "result"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.ToolEvent"}, "action": {"type": "string"}, "invocation": {"$ref": "#/$defs/nullableContract"}, "output": {"$ref": "#/$defs/nullableContract"}, "result": {"$ref": "#/$defs/nullableContract"}}},
    "interaction": {"type": "object", "required": ["$type", "action", "request", "response", "interaction_id"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.InteractionEvent"}, "action": {"type": "string"}, "request": {"$ref": "#/$defs/nullableContract"}, "response": {"$ref": "#/$defs/nullableContract"}, "interaction_id": {"type": ["string", "null"]}}},
    "contextStats": {"type": "object", "required": ["$type", "used_tokens", "context_window", "percent", "input_tokens", "output_tokens"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.lifecycle.ContextStats"}, "used_tokens": {"type": "integer", "minimum": 0}, "context_window": {"type": "integer", "minimum": 0}, "percent": {"type": "number", "minimum": 0, "maximum": 100}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}}},
    "usage": {"type": "object", "required": ["$type", "context"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.UsageEvent"}, "context": {"$ref": "#/$defs/contextStats"}}},
    "change": {"type": "object", "required": ["$type", "revision", "subject_id", "summary"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.ChangeEvent"}, "revision": {"type": "integer"}, "subject_id": {"type": "string"}, "summary": {"type": "string"}}},
    "notice": {"type": "object", "required": ["$type", "level", "message", "details"], "additionalProperties": false, "properties": {"$type": {"const": "kairo_kernel.contracts.events.NoticeEvent"}, "level": {"type": "string"}, "message": {"type": "string"}, "details": {"$ref": "#/$defs/jsonObject"}}}
  }
}

/* Chat-first shell layout: TopBar / Transcript / Composer / StatusLine.
   No nav rail, no setup screen, no global width:1fr on form widgets. */

#workbench {
    layout: vertical;
    background: $background;
}

#topbar {
    height: 2;
    padding: 0 2;
    content-align: left middle;
    color: $text;
    background: $surface;
    border-bottom: solid $panel;
}

#transcript {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#composer {
    height: 5;
    min-height: 3;
    max-height: 8;
    margin: 0 2 1 2;
    padding: 1 1;
    border: round $panel;
    background: $surface;
}

#composer:focus {
    border: round $accent;
}

#status-line {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

/* Connect modal: fixed field order, always on-screen, never full width. */
#connect-modal {
    width: 76;
    max-width: 100%;
    max-height: 100%;
    margin: 1 2;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
}

#connect-title {
    text-style: bold;
    margin-bottom: 1;
}

#connect-modal Label {
    margin-top: 1;
}

#connect-modal Input,
#connect-modal Select {
    height: 3;
    width: 100%;
}

#connect-error {
    color: $error;
    height: 2;
    margin-top: 1;
}

#connect-actions {
    height: auto;
    margin-top: 1;
}

#connect-actions Button {
    min-width: 0;
    margin: 0 1 0 0;
}

/* Sidebars: hidden by default, docked on wide screens, overlay on narrow. */
.sidebar {
    display: none;
    width: 40;
    min-width: 40;
    height: 1fr;
    padding: 0 1;
    background: $surface;
    border-left: solid $panel;
    overflow-y: auto;
}

.sidebar.sidebar-open {
    display: block;
    position: absolute;
    dock: right;
    width: 40;
    height: 1fr;
}
